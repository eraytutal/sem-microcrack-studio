* {
    font-family: "Segoe UI";
    font-size: 10pt;
    color: #dbe7f3;
}

QMainWindow,
QWidget#workspace {
    background: #0b1016;
}

QFrame#sidebar {
    background: #0f1720;
    border-right: 1px solid #203040;
}

QLabel#sidebarBrand {
    color: #f8fafc;
    font-size: 13pt;
    font-weight: 700;
}

QLabel#sidebarSubtitle,
QLabel#sidebarFooter,
QLabel#mutedText,
QLabel.mutedText {
    color: #7f8ea3;
}

QPushButton#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #b8c6d8;
    font-weight: 600;
    padding: 9px 9px;
    text-align: left;
}

QPushButton#navButton:hover {
    background: #142131;
    border-color: #22364a;
}

QPushButton#navButton[active="true"] {
    background: #123044;
    border-color: #1d6d89;
    color: #e6fbff;
}

QFrame#topHeader,
QFrame#toolbarPanel,
QFrame#sidePanel,
QFrame#contentPanel,
QFrame#summaryCard {
    background: #111923;
    border: 1px solid #223244;
    border-radius: 10px;
}

QScrollArea#sidePanelScroll {
    background: transparent;
    border: 0;
}

QScrollArea#sidePanelScroll > QWidget > QWidget {
    background: transparent;
}

QLabel#pageTitle {
    color: #f8fafc;
    font-size: 16pt;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #90a1b6;
    font-size: 9.5pt;
}

QLabel#panelTitle {
    color: #f1f5f9;
    font-size: 12pt;
    font-weight: 700;
}

QFrame#reviewStatusCard {
    background: #0d141d;
    border: 1px solid #243648;
    border-radius: 8px;
}

QFrame#annotationListCard {
    background: #0d141d;
    border: 1px solid #243648;
    border-radius: 8px;
}

QFrame#saveStateCard {
    background: #0d141d;
    border: 1px solid #243648;
    border-radius: 8px;
}

QFrame#saveStateCard[saveState="unsaved"],
QFrame#saveStateCard[saveState="pending"] {
    background: #1c170b;
    border-color: #b7791f;
}

QFrame#saveStateCard[saveState="saved"] {
    background: #0d1715;
    border-color: #24483f;
}

QLabel#reviewStatusTitle {
    color: #f1f5f9;
    font-weight: 700;
}

QLabel#annotationListTitle {
    color: #f1f5f9;
    font-weight: 700;
}

QLabel#saveStateTitle {
    color: #f1f5f9;
    font-weight: 700;
}

QLabel#saveStateHelper {
    color: #d8bd7a;
    font-size: 9pt;
}

QLabel#reviewStatusBadge {
    border-radius: 8px;
    font-size: 9pt;
    font-weight: 700;
    padding: 3px 9px;
}

QLabel#reviewStatusBadge[reviewStatus="unreviewed"] {
    background: #18212c;
    border: 1px solid #465668;
    color: #cbd5e1;
}

QLabel#reviewStatusBadge[reviewStatus="annotated"] {
    background: #123044;
    border: 1px solid #1d6d89;
    color: #88e5f7;
}

QLabel#reviewStatusBadge[reviewStatus="no_defect"] {
    background: #123326;
    border: 1px solid #1d7a56;
    color: #86efac;
}

QLabel#reviewStatusBadge[reviewStatus="pending"] {
    background: #3a2a11;
    border: 1px solid #b7791f;
    color: #fde68a;
}

QLabel#reviewStatusHelper {
    color: #9fb0c4;
}

QLabel#fieldLabel {
    color: #aebdd0;
    font-weight: 600;
}

QLabel#thresholdValue {
    color: #22d3ee;
    font-weight: 700;
    min-width: 34px;
}

QFrame#imageViewer,
QGraphicsView#imageViewer {
    background: #05070a;
    border: 1px solid #26384a;
    border-radius: 10px;
}

QFrame#imageNavigationBar {
    background: transparent;
    border: 0;
}

QWidget#imageNavigationControls {
    background: #0d141d;
    border: 1px solid #26384a;
    border-radius: 8px;
}

QPushButton#imageNavigationButton {
    min-width: 96px;
    max-width: 120px;
    padding: 5px 10px;
}

QLabel#imageNavigationLabel {
    color: #cbd7e6;
    font-weight: 700;
    min-width: 220px;
    max-width: 300px;
    qproperty-alignment: AlignCenter;
}

QLabel#viewerPlaceholder {
    color: #6f7f92;
    font-size: 15pt;
    font-weight: 600;
}

QPushButton,
QToolButton {
    background: #172333;
    border: 1px solid #2a4056;
    border-radius: 7px;
    color: #d9e5f2;
    font-weight: 600;
    padding: 7px 12px;
}

QPushButton:hover,
QToolButton:hover {
    background: #1d3145;
    border-color: #2a718f;
}

QPushButton:pressed,
QToolButton:pressed {
    background: #102638;
}

QPushButton[emphasized="true"] {
    background: #123044;
    border-color: #1d6d89;
    color: #e6fbff;
}

QPushButton:disabled {
    background: #162231;
    border-color: #33485d;
    color: #9aabba;
}

QToolButton#toolIconButton {
    padding: 7px 10px;
}

QFrame#predictionRow,
QFrame#checkRow {
    background: #0d141d;
    border: 1px solid #243648;
    border-radius: 8px;
}

QLabel#predictionTitle {
    color: #e7eef8;
    font-weight: 700;
}

QLabel#statusPill {
    background: #142637;
    border: 1px solid #24516a;
    border-radius: 8px;
    color: #88e5f7;
    font-size: 9pt;
    font-weight: 700;
    padding: 2px 8px;
}

QLabel#summaryValue {
    color: #f8fafc;
    font-size: 22pt;
    font-weight: 800;
}

QLabel#summaryLabel {
    color: #95a6ba;
    font-weight: 700;
}

QComboBox,
QDoubleSpinBox,
QTextEdit,
QLineEdit,
QListWidget {
    background: #0b121a;
    border: 1px solid #2a4056;
    border-radius: 7px;
    color: #dbe7f3;
    padding: 6px 8px;
    selection-background-color: #155e75;
}

QListWidget#imageList {
    padding: 4px;
    outline: 0;
}

QListWidget#annotationList {
    background: #0b121a;
    border: 1px solid #2a4056;
    border-radius: 7px;
    color: #dbe7f3;
    outline: 0;
    padding: 4px;
}

QListWidget#imageList::item {
    border-radius: 5px;
    color: #aebdd0;
    padding: 6px 8px;
}

QListWidget#annotationList::item {
    border-radius: 5px;
    color: #aebdd0;
    padding: 5px 8px;
}

QListWidget#imageList::item:hover {
    background: #142131;
    color: #e4eef8;
}

QListWidget#annotationList::item:hover {
    background: #142131;
    color: #e4eef8;
}

QListWidget#imageList::item:selected {
    background: #123044;
    color: #e6fbff;
}

QListWidget#annotationList::item:selected {
    background: #123044;
    color: #e6fbff;
}

QTableWidget#datasetStatusTable {
    background: #0b121a;
    alternate-background-color: #0f1720;
    border: 1px solid #2a4056;
    border-radius: 8px;
    color: #dbe7f3;
    gridline-color: #223244;
    outline: 0;
    selection-background-color: #123044;
    selection-color: #e6fbff;
}

QTableWidget#datasetStatusTable::item {
    padding: 6px 8px;
}

QHeaderView::section {
    background: #111923;
    border: 0;
    border-bottom: 1px solid #2a4056;
    color: #aebdd0;
    font-weight: 700;
    padding: 7px 8px;
}

QComboBox#propertyField,
QDoubleSpinBox#propertyField,
QLineEdit#propertyField {
    background: #0f1a25;
    border: 1px solid #3a5870;
    border-left: 3px solid #22d3ee;
    color: #edf6ff;
    font-weight: 600;
    min-height: 26px;
}

QComboBox#propertyField:hover,
QDoubleSpinBox#propertyField:hover,
QLineEdit#propertyField:hover {
    border-color: #4a7895;
    border-left-color: #67e8f9;
}

QComboBox::drop-down {
    border: 0;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #0b121a;
    border: 1px solid #2a4056;
    border-radius: 6px;
    color: #dbe7f3;
    selection-background-color: #123044;
    selection-color: #e6fbff;
    outline: 0;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 5px 8px;
    color: #dbe7f3;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background: #123044;
    color: #e6fbff;
}

QLineEdit#propertyField[readOnly="true"] {
    color: #aebdd0;
    background: #0d1721;
}

QTextEdit {
    padding: 8px;
}

QCheckBox {
    color: #cbd7e6;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #375169;
    background: #0b121a;
}

QCheckBox::indicator:checked {
    background: #0b121a;
    border: 1px solid #22d3ee;
    image: url(:/qt-project.org/styles/commonstyle/images/standardbutton-apply-16.png);
}

QSlider::groove:horizontal {
    background: #27384a;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0891b2;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #22d3ee;
    border: 1px solid #a5f3fc;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QStatusBar#statusBar {
    background: #0f1720;
    border-top: 1px solid #203040;
}

QStatusBar#statusBar QLabel {
    color: #95a6ba;
    padding: 0 8px;
}

QLabel#placeholderNote {
    background: #0d1721;
    border: 1px solid #2c4154;
    border-radius: 8px;
    color: #b8c7d6;
    padding: 9px 10px;
}
